# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
.env

# Jupyter
.ipynb_checkpoints/

# Datos, modelos y pronósticos: los versiona DVC, nunca Git.
# Se ignora el contenido pero se conservan las carpetas (.gitkeep)
# y los punteros de DVC (*.dvc, .gitignore) para que se puedan commitear.
/data/**
/models/**
/forecasts/**
!/data/**/
!/models/**/
!/forecasts/**/
!/data/**/.gitkeep
!/models/**/.gitkeep
!/forecasts/**/.gitkeep
!/data/**/*.dvc
!/models/**/*.dvc
!/forecasts/**/*.dvc
!/data/**/.gitignore
!/models/**/.gitignore
!/forecasts/**/.gitignore
*.pkl
*.joblib

# IDE / SO
.vscode/
.idea/
.DS_Store
