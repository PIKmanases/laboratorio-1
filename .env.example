# Copiar a .env (no se versiona).
# UID del usuario del host, para que Airflow escriba data/ y forecasts/ con tus permisos: `id -u`
AIRFLOW_UID=1000
# Secreto compartido entre los componentes de Airflow 3. Generar con: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW_JWT_SECRET=
